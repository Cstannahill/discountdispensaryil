# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Store verifier (backend/verifier.py). Without a key it reports "not_configured" and makes no request.
TERPSCOUT_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Default model; override per run with scripts/verify_stores.py --model <id> (repeatable, or --model all).
TERPSCOUT_LLM_MODEL=deepseek/deepseek-v4.1-flash
# Models offered by --model all. OpenRouter ids as listed at https://openrouter.ai/api/v1/models (the GLM alias has a ~).
# :batch variants are refused: they only run through the asynchronous Batch API (24h window), which does not fit a multi-step loop.
TERPSCOUT_LLM_MODELS=~z-ai/glm-flash-latest,xiaomi/mimo-v2.6-flash,deepseek/deepseek-v4.1-flash,anthropic/claude-haiku-5.5,openai/gpt-6-luna-pro
VERIFIER_MAX_STEPS=8
VERIFIER_MAX_SECONDS=60
VERIFIER_MAX_TOKENS=40000
VERIFIER_MAX_USD_PER_STORE=0.05
# Daily cap shared by the verifier and website discovery. Both search through OpenRouter's web plugin (Exa, 5 results,
# about $0.007 a search on top of tokens); every charge is logged to data/evidence/llm-spend.jsonl.
VERIFIER_MAX_USD_PER_DAY=1.00
# Web search order, comma separated: `mcp` (local WebSearch MCP server, free) then `openrouter` (paid Exa). The first provider
# with results answers; an error, timeout or empty answer falls through to the next. `openrouter` alone restores the old behavior.
TERPSCOUT_SEARCH_PROVIDER=mcp,openrouter
TERPSCOUT_WEBSEARCH_MCP_URL=http://localhost:9565/mcp
TERPSCOUT_WEBSEARCH_MCP_TIMEOUT=20
# Neon Postgres mirror (backend/neon_mirror.py): pushed after each full sync. Leave empty to disable.
NEON_DATABASE_URL=
# Docker (docker-compose.yml): override only if the WebSearch MCP lives elsewhere than the Docker host, and the bind address.
# TERPSCOUT_WEBSEARCH_MCP_URL=http://192.168.1.10:9565/mcp
# TERPSCOUT_BIND=127.0.0.1
